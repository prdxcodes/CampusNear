<% layout("/layouts/boilerplate") %>

<div class="listing-page">

    <div class="listing-header">

        <div>

            <p class="section-label">
                STUDENT SERVICES
            </p>

            <h1>
                <%= selectedCollege
                    ? `Laundry Near ${selectedCollege.name}`
                    : "Find Laundry Near Your College"
                %>
            </h1>

            <p class="listing-subtitle">

                <% if (selectedCollege) { %>

                    Showing laundry services within 5 km of
                    <strong>
                        <%= selectedCollege.name %>
                    </strong>.

                <% } else { %>

                    Select your college to discover laundry services
                    within 5 km of your campus.

                <% } %>

            </p>

        </div>

        <div class="listing-count">
            <%= allPlaces.length %> Laundries
        </div>

    </div>


    <div class="row">

        <% if (!selectedCollege) { %>

            <div class="col-12">

                <div class="empty-state">

                    <i class="fa-solid fa-location-dot"></i>

                    <h3>
                        Select Your College
                    </h3>

                    <p>
                        Choose your college from the homepage to find
                        nearby laundry services.
                    </p>

                    <a href="/" class="btn btn-dark">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        Search College
                    </a>

                </div>

            </div>

        <% } else if (allPlaces.length === 0) { %>

            <div class="col-12">

                <div class="empty-state">

                    <i class="fa-solid fa-shirt"></i>

                    <h3>
                        No Laundry Services Found Nearby
                    </h3>

                    <p>
                        There are currently no laundry services listed
                        within 5 km of
                        <strong><%= selectedCollege.name %></strong>.
                    </p>

                    <a href="/laundries/new" class="btn btn-dark">
                        Add Laundry
                    </a>

                </div>

            </div>

        <% } else { %>

            <% allPlaces.forEach(laundry => { %>

                <div class="col-lg-4 col-md-6 mb-4">

                    <a
                        href="/laundries/<%= laundry._id %>"
                        class="text-decoration-none"
                    >

                        <div class="listing-card">

                            <div class="listing-image-wrapper">

                                <% if (
                                    laundry.image &&
                                    laundry.image.url
                                ) { %>

                                    <img
                                        src="<%= laundry.image.url %>"
                                        alt="<%= laundry.title %>"
                                        class="listing-image"
                                    >

                                <% } else { %>

                                    <div class="no-image">
                                        <i class="fa-solid fa-shirt"></i>
                                    </div>

                                <% } %>

                            </div>


                            <div class="listing-card-body">

                                <div class="listing-category">
                                    LAUNDRY
                                </div>

                                <h3>
                                    <%= laundry.title %>
                                </h3>

                                <p class="listing-location">

                                    <i class="fa-solid fa-location-dot"></i>

                                    <%= laundry.location %>

                                </p>


                                <div class="listing-info">

                                    <span>
                                        <i class="fa-solid fa-soap"></i>
                                        Laundry Service
                                    </span>

                                    <% if (laundry.pickupDelivery) { %>

                                        <span>
                                            <i class="fa-solid fa-truck"></i>
                                            Pickup & Delivery
                                        </span>

                                    <% } %>

                                </div>


                                <% if (
                                    laundry.serviceType &&
                                    laundry.serviceType.length
                                ) { %>

                                    <div class="service-features">

                                        <% laundry.serviceType.forEach(service => { %>

                                            <span>
                                                <%= service %>
                                            </span>

                                        <% }) %>

                                    </div>

                                <% } %>


                                <div class="listing-bottom">

                                    <strong>
                                        ₹<%= laundry.price %>
                                    </strong>

                                    <span class="feature-badge">
                                        View Laundry
                                    </span>

                                </div>

                            </div>

                        </div>

                    </a>

                </div>

            <% }) %>

        <% } %>

    </div>

</div>