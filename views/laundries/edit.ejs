<% layout("/layouts/boilerplate") %>

<div class="row">
    <div class="col col-8 offset-2">

        <br>

        <h3>Edit Your Laundry</h3>

        <br>

        <form
            method="post"
            action="/laundries/<%= laundry._id %>?_method=put"
            novalidate
            class="needs-validation"
            enctype="multipart/form-data"
        >

            <!-- TITLE -->
            <div class="mb-3">

                <label class="form-label">
                    Laundry Name
                </label>

                <input
                    name="laundry[title]"
                    value="<%= laundry.title || '' %>"
                    type="text"
                    class="form-control"
                    required
                >

                <div class="invalid-feedback">
                    Please enter laundry name.
                </div>

            </div>


            <!-- DESCRIPTION -->
            <div class="mb-3">

                <label class="form-label">
                    Description
                </label>

                <textarea
                    name="laundry[description]"
                    class="form-control"
                    required
                ><%= laundry.description || '' %></textarea>

                <div class="invalid-feedback">
                    Please enter description.
                </div>

            </div>


            <!-- EXISTING IMAGE -->
            <div class="mb-3">

                <label class="form-label">
                    Existing Image
                </label>

                <br>

                <% if (originalImageUrl) { %>

                    <img
                        src="<%= originalImageUrl %>"
                        class="img-fluid rounded"
                        style="max-width:250px;"
                    >

                <% } %>

            </div>


            <!-- NEW IMAGE -->
            <div class="mb-3">

                <label class="form-label">
                    Upload New Image
                </label>

                <input
                    name="laundry[image][url]"
                    type="file"
                    class="form-control"
                    accept="image/*"
                >

            </div>


            <!-- PRICE + COUNTRY -->
            <div class="row">

                <div class="mb-3 col-md-6">

                    <label class="form-label">
                        Price
                    </label>

                    <input
                        name="laundry[price]"
                        value="<%= laundry.price || '' %>"
                        type="number"
                        min="0"
                        class="form-control"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter price.
                    </div>

                </div>


                <div class="mb-3 col-md-6">

                    <label class="form-label">
                        Country
                    </label>

                    <input
                        name="laundry[country]"
                        value="<%= laundry.country || 'India' %>"
                        type="text"
                        class="form-control"
                        required
                    >

                </div>

            </div>


            <!-- OWNER CONTACT -->
            <div class="mb-3">

                <label class="form-label">
                    Owner Contact
                </label>

                <input
                    name="laundry[ownerContact]"
                    value="<%= laundry.ownerContact || '' %>"
                    type="tel"
                    class="form-control"
                    placeholder="10-digit mobile number"
                    pattern="[6-9][0-9]{9}"
                    maxlength="10"
                    required
                >

                <div class="invalid-feedback">
                    Please enter a valid 10-digit mobile number.
                </div>

            </div>


            <!-- SERVICE TYPE -->
            <div class="mb-3">

                <label class="form-label">
                    Service Type
                </label>

                <div class="form-check">

                    <input
                        class="form-check-input"
                        type="checkbox"
                        name="laundry[serviceType][]"
                        value="Washing"
                        id="washing"
                        <%= laundry.serviceType?.includes("Washing")
                            ? "checked"
                            : "" %>
                    >

                    <label
                        class="form-check-label"
                        for="washing"
                    >
                        Washing
                    </label>

                </div>


                <div class="form-check">

                    <input
                        class="form-check-input"
                        type="checkbox"
                        name="laundry[serviceType][]"
                        value="Dry Cleaning"
                        id="dryCleaning"
                        <%= laundry.serviceType?.includes("Dry Cleaning")
                            ? "checked"
                            : "" %>
                    >

                    <label
                        class="form-check-label"
                        for="dryCleaning"
                    >
                        Dry Cleaning
                    </label>

                </div>


                <div class="form-check">

                    <input
                        class="form-check-input"
                        type="checkbox"
                        name="laundry[serviceType][]"
                        value="Ironing"
                        id="ironing"
                        <%= laundry.serviceType?.includes("Ironing")
                            ? "checked"
                            : "" %>
                    >

                    <label
                        class="form-check-label"
                        for="ironing"
                    >
                        Ironing
                    </label>

                </div>


                <div class="form-check">

                    <input
                        class="form-check-input"
                        type="checkbox"
                        name="laundry[serviceType][]"
                        value="Washing & Ironing"
                        id="washingIroning"
                        <%= laundry.serviceType?.includes("Washing & Ironing")
                            ? "checked"
                            : "" %>
                    >

                    <label
                        class="form-check-label"
                        for="washingIroning"
                    >
                        Washing & Ironing
                    </label>

                </div>


                <div class="form-check">

                    <input
                        class="form-check-input"
                        type="checkbox"
                        name="laundry[serviceType][]"
                        value="All Services"
                        id="allServices"
                        <%= laundry.serviceType?.includes("All Services")
                            ? "checked"
                            : "" %>
                    >

                    <label
                        class="form-check-label"
                        for="allServices"
                    >
                        All Services
                    </label>

                </div>

            </div>


            <!-- PICKUP & DELIVERY -->
            <div class="mb-3">

                <label class="form-label">
                    Pickup & Delivery
                </label>

                <div class="form-check">

                    <input
                        class="form-check-input"
                        type="checkbox"
                        name="laundry[pickupDelivery]"
                        value="true"
                        id="pickupDelivery"
                        <%= laundry.pickupDelivery ? "checked" : "" %>
                    >

                    <label
                        class="form-check-label"
                        for="pickupDelivery"
                    >
                        Pickup & Delivery Available
                    </label>

                </div>

            </div>


            <!-- COLLEGE -->
            <div class="mb-3">

                <label class="form-label">
                    Nearby College
                </label>

                <select
                    name="laundry[college]"
                    class="form-select"
                    required
                >

                    <option value="">
                        Select College
                    </option>

                    <% colleges.forEach(college => { %>

                        <option
                            value="<%= college._id %>"
                            <%= laundry.college &&
                                laundry.college._id.toString() === college._id.toString()
                                ? "selected"
                                : "" %>
                        >

                            <%= college.name %>

                            <% if (college.shortName) { %>
                                (<%= college.shortName %>)
                            <% } %>

                        </option>

                    <% }) %>

                </select>

                <div class="invalid-feedback">
                    Please select a nearby college.
                </div>

            </div>


            <!-- LOCATION -->
            <div class="mb-3">

                <label
                    for="location"
                    class="form-label"
                >
                    Location
                </label>

                <input
                    id="location"
                    name="laundry[location]"
                    value="<%= laundry.location || '' %>"
                    type="text"
                    class="form-control"
                    placeholder="Search your location..."
                    autocomplete="off"
                    required
                >

                <!-- Suggestions -->
                <div
                    id="locationSuggestions"
                    class="location-suggestions">
                </div>

            </div>


            <!-- SEARCH LOCATION -->
            <div class="mb-3">

                <button
                    type="button"
                    id="searchLocationBtn"
                    class="btn btn-primary"
                >
                    Search Location
                </button>

            </div>


            <!-- MAP -->
            <div id="map"></div>


            <!-- LATITUDE -->
            <input
                type="hidden"
                name="laundry[latitude]"
                id="latitude"
                value="<%= laundry.geocoding?.coordinates?.[1] || '' %>"
            >


            <!-- LONGITUDE -->
            <input
                type="hidden"
                name="laundry[longitude]"
                id="longitude"
                value="<%= laundry.geocoding?.coordinates?.[0] || '' %>"
            >


            <!-- COORDINATES -->
            <p
                id="coordinatesText"
                class="text-muted mt-2"
            >

                <% if (
                    laundry.geocoding &&
                    laundry.geocoding.coordinates &&
                    laundry.geocoding.coordinates.length === 2
                ) { %>

                    Current coordinates:
                    <%= laundry.geocoding.coordinates[1].toFixed(6) %>,
                    <%= laundry.geocoding.coordinates[0].toFixed(6) %>

                <% } else { %>

                    Select your exact location on the map.

                <% } %>

            </p>


            <br>


            <!-- SUBMIT -->
            <button
                class="btn btn-dark edit-btn"
                type="submit"
            >
                Update Laundry
            </button>

            <br><br>

        </form>

    </div>
</div>


<style>

#map {
    height: 400px;
    width: 100%;
    border-radius: 12px;
    margin-top: 15px;
    margin-bottom: 20px;
}


.location-suggestions {
    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    max-height: 250px;
    overflow-y: auto;
    position: relative;
    z-index: 9999;
}


.suggestion-item {
    padding: 12px 15px;
    cursor: pointer;
    border-bottom: 1px solid #eee;
    font-size: 14px;
}


.suggestion-item:hover {
    background: #f5f5f5;
}

</style>