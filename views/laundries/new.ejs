<% layout("/layouts/boilerplate") %>

<div class="service-form-page">

    <div class="service-form-container">

        <div class="service-form-card">

            <div class="service-form-header">

                <span class="service-form-badge">
                    LAUNDRY
                </span>

                <h2>List Your Laundry</h2>

                <p>
                    Help students find convenient laundry services near their college.
                </p>

            </div>


            <form
                method="POST"
                action="/laundries"
                novalidate
                class="needs-validation service-form"
                enctype="multipart/form-data"
            >

                <!-- =========================================
                     TITLE
                ========================================== -->

                <div class="form-group">

                    <label for="title">
                        Laundry Name
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="laundry[title]"
                        class="form-control"
                        placeholder="e.g. Quick Wash Laundry"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter the laundry name.
                    </div>

                </div>


                <!-- =========================================
                     DESCRIPTION
                ========================================== -->

                <div class="form-group">

                    <label for="description">
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="laundry[description]"
                        class="form-control"
                        placeholder="Describe your laundry services..."
                        required
                    ></textarea>

                    <div class="invalid-feedback">
                        Please enter a description.
                    </div>

                </div>


                <!-- =========================================
                     IMAGE
                ========================================== -->

                <div class="form-group">

                    <label for="image">
                        Laundry Image
                    </label>

                    <input
                        type="file"
                        id="image"
                        name="laundry[image][url]"
                        class="form-control"
                        accept="image/*"
                        required
                    >

                    <small>
                        Upload a clear image of the laundry service.
                    </small>

                </div>


                <!-- =========================================
                     PRICE
                ========================================== -->

                <div class="form-group">

                    <label for="price">
                        Starting Price (₹)
                    </label>

                    <input
                        type="number"
                        id="price"
                        name="laundry[price]"
                        class="form-control"
                        placeholder="e.g. 50"
                        min="0"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a valid starting price.
                    </div>

                </div>


                <!-- =========================================
                     COUNTRY
                ========================================== -->

                <div class="form-group">

                    <label for="country">
                        Country
                    </label>

                    <input
                        type="text"
                        id="country"
                        name="laundry[country]"
                        class="form-control"
                        value="India"
                        required
                    >

                </div>


                <!-- =========================================
                     LOCATION
                ========================================== -->

                <div class="form-group">

                    <label for="location">
                        Location
                    </label>

                    <input
                        type="text"
                        id="location"
                        name="laundry[location]"
                        class="form-control"
                        placeholder="Search your location..."
                        autocomplete="off"
                        required
                    >

                    <!-- Location Suggestions -->

                    <div
                        id="locationSuggestions"
                        class="location-suggestions"
                    ></div>

                </div>


                <!-- =========================================
                     SEARCH LOCATION
                ========================================== -->

                <div class="form-group">

                    <button
                        type="button"
                        id="searchLocationBtn"
                        class="btn btn-primary"
                    >
                        Search Location
                    </button>

                </div>


                <!-- =========================================
                     MAP
                ========================================== -->

                <div
                    id="map"
                    style="height: 400px; width: 100%; border-radius: 12px;"
                ></div>


                <!-- =========================================
                     COORDINATES
                ========================================== -->

                <input
                    type="hidden"
                    name="laundry[latitude]"
                    id="latitude"
                >

                <input
                    type="hidden"
                    name="laundry[longitude]"
                    id="longitude"
                >

                <p
                    id="coordinatesText"
                    class="text-muted mt-2"
                >
                    Search a location and drag the marker to the exact location.
                </p>


                <!-- =========================================
                     OWNER CONTACT
                ========================================== -->

                <div class="form-group">

                    <label for="ownerContact">
                        Owner Contact Number
                    </label>

                    <input
                        type="tel"
                        id="ownerContact"
                        name="laundry[ownerContact]"
                        class="form-control"
                        placeholder="10-digit mobile number"
                        pattern="[6-9][0-9]{9}"
                        maxlength="10"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a valid 10-digit mobile number.
                    </div>

                </div>


                <!-- =========================================
                     SERVICE TYPE
                ========================================== -->

                <div class="form-group">

                    <label for="serviceType">
                        Service Type
                    </label>

                    <select
                        id="serviceType"
                        name="laundry[serviceType][]"
                        class="form-select"
                        required
                    >

                        <option
                            value=""
                            selected
                            disabled
                        >
                            Select service
                        </option>

                        <option value="Washing">
                            Washing
                        </option>

                        <option value="Dry Cleaning">
                            Dry Cleaning
                        </option>

                        <option value="Ironing">
                            Ironing
                        </option>

                        <option value="Washing & Ironing">
                            Washing & Ironing
                        </option>

                        <option value="All Services">
                            All Services
                        </option>

                    </select>

                    <div class="invalid-feedback">
                        Please select a laundry service.
                    </div>

                </div>


                <!-- =========================================
                     PICKUP & DELIVERY
                ========================================== -->

                <div class="form-group">

                    <label for="pickupDelivery">
                        Pickup & Delivery
                    </label>

                    <select
                        id="pickupDelivery"
                        name="laundry[pickupDelivery]"
                        class="form-select"
                        required
                    >

                        <option
                            value=""
                            selected
                            disabled
                        >
                            Select
                        </option>

                        <option value="true">
                            Available
                        </option>

                        <option value="false">
                            Not Available
                        </option>

                    </select>

                    <div class="invalid-feedback">
                        Please select pickup & delivery availability.
                    </div>

                </div>


                <!-- =========================================
                     COLLEGE
                ========================================== -->

                <div class="form-group">

                    <label for="college">
                        Nearby College
                    </label>

                    <select
                        id="college"
                        name="laundry[college]"
                        class="form-select"
                        required
                    >

                        <option
                            value=""
                            selected
                            disabled
                        >
                            Select College
                        </option>

                        <% colleges.forEach(college => { %>

                            <option value="<%= college._id %>">

                                <%= college.name %>

                                <% if (college.shortName) { %>

                                    (<%= college.shortName %>)

                                <% } %>

                            </option>

                        <% }) %>

                    </select>

                    <div class="invalid-feedback">
                        Please select a nearby college.
                    </div>

                </div>


                <!-- =========================================
                     SUBMIT
                ========================================== -->

                <button
                    type="submit"
                    class="service-submit-btn"
                >
                    Add Laundry
                </button>

            </form>

        </div>

    </div>

</div>