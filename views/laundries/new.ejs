<% layout("/layouts/boilerplate") %>

    <div class="service-form-page">

        <div class="service-form-container">

            <div class="service-form-card">

                <div class="service-form-header">

                    <span class="service-form-badge">
                        LAUNDRY
                    </span>

                    <h2>List Your Laundry</h2>

                    <p>
                        Help students find convenient laundry services near their college.
                    </p>

                </div>


                <form method="POST" action="/laundries" novalidate class="needs-validation service-form"
                    enctype="multipart/form-data">

                    <!-- TITLE -->

                    <div class="form-group">

                        <label for="title">
                            Laundry Name
                        </label>

                        <input type="text" id="title" name="laundry[title]" class="form-control"
                            placeholder="e.g. Quick Wash Laundry" required>

                    </div>


                    <!-- DESCRIPTION -->

                    <div class="form-group">

                        <label for="description">
                            Description
                        </label>

                        <textarea id="description" name="laundry[description]" class="form-control"
                            placeholder="Describe your laundry services..." required></textarea>

                    </div>


                    <!-- IMAGE -->

                    <div class="form-group">

                        <label for="image">
                            Laundry Image
                        </label>

                        <input type="file" id="image" name="laundry[image][url]" class="form-control" accept="image/*"
                            required>

                    </div>


                    <!-- PRICE -->

                    <div class="form-group">

                        <label for="price">
                            Starting Price (₹)
                        </label>

                        <input type="number" id="price" name="laundry[price]" class="form-control" placeholder="e.g. 50"
                            min="0" required>

                    </div>


                    <!-- COUNTRY -->

                    <div class="form-group">

                        <label for="country">
                            Country
                        </label>

                        <input type="text" id="country" name="laundry[country]" class="form-control" value="India"
                            required>

                    </div>


                    <!-- LOCATION -->

                    <div class="mb-3">
                        <label for="location" class="form-label">Location</label>

                        <input type="text" id="location" name="location" class="form-control"
                            placeholder="Search your location..." autocomplete="off" required>

                        <!-- Suggestions -->
                        <div id="locationSuggestions" class="location-suggestions"></div>
                    </div>

                    <div class="mb-3">
                        <button type="button" id="searchLocationBtn" class="btn btn-primary">
                            Search Location
                        </button>
                    </div>

                    <div id="map"></div>

                    <input type="hidden" name="latitude" id="latitude">
                    <input type="hidden" name="longitude" id="longitude">

                    <p id="coordinatesText" class="text-muted mt-2">
                        Select your exact location on the map.
                    </p>
                    <!-- CONTACT -->

                    <div class="form-group">

                        <label for="ownerContact">
                            Owner Contact Number
                        </label>

                        <input type="tel" id="ownerContact" name="laundry[ownerContact]" class="form-control"
                            placeholder="10-digit mobile number" pattern="[6-9][0-9]{9}" maxlength="10" required>

                    </div>


                    <!-- SERVICE TYPE -->

                    <div class="form-group">

                        <label for="serviceType">
                            Service Type
                        </label>

                        <select id="serviceType" name="laundry[serviceType]" class="form-select" required>

                            <option value="" selected disabled>
                                Select service
                            </option>

                            <option value="Washing">
                                Washing
                            </option>

                            <option value="Dry Cleaning">
                                Dry Cleaning
                            </option>

                            <option value="Ironing">
                                Ironing
                            </option>

                            <option value="Washing & Ironing">
                                Washing & Ironing
                            </option>

                            <option value="All Services">
                                All Services
                            </option>

                        </select>

                    </div>


                    <!-- PICKUP DELIVERY -->

                    <div class="form-group">

                        <label for="pickupDelivery">
                            Pickup & Delivery
                        </label>

                        <select id="pickupDelivery" name="laundry[pickupDelivery]" class="form-select" required>

                            <option value="" selected disabled>
                                Select
                            </option>

                            <option value="true">
                                Available
                            </option>

                            <option value="false">
                                Not Available
                            </option>

                        </select>

                    </div>


                    <!-- COLLEGE -->

                    <div class="form-group">

                        <label for="college">
                            Nearby College
                        </label>

                        <select id="college" name="laundry[college]" class="form-select" required>

                            <option value="" selected disabled>
                                Select College
                            </option>

                            <% colleges.forEach(college=> { %>

                                <option value="<%= college._id %>">
                                    <%= college.name %>
                                        <% if (college.shortName) { %>
                                            (<%= college.shortName %>)
                                                <% } %>
                                </option>

                                <% }) %>

                        </select>

                    </div>


                    <button type="submit" class="service-submit-btn">
                        Add Laundry
                    </button>

                </form>

            </div>

        </div>

    </div>

    <script src="/js/script.js"></script>