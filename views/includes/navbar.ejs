<!-- =========================================================
     CAMPUSNEAR NAVBAR
========================================================= -->

<nav class="campusnear-navbar">

    <div class="navbar-container">

        <!-- LOGO -->
        <a href="/" class="campusnear-logo">
            <span class="logo-icon">
                <i class="fa-solid fa-compass"></i>
            </span>
            <span class="logo-text">
                Campus<span>Near</span>
            </span>
        </a>

        <!-- NAVIGATION LINKS -->
        <% const selectedCollege = typeof queryCollege !== "undefined" ? queryCollege : null; %>

        <div class="navbar-links" id="navbarLinks">
            <a href="<%= selectedCollege ? '/pgs?college=' + encodeURIComponent(selectedCollege) : '/pgs' %>" 
               class="nav-link <%= currentPath.startsWith('/pgs') ? 'active' : '' %>">
                PGs
            </a>

            <a href="<%= selectedCollege ? '/messes?college=' + encodeURIComponent(selectedCollege) : '/messes' %>" 
               class="nav-link <%= currentPath.startsWith('/messes') ? 'active' : '' %>">
                Messes
            </a>

            <a href="<%= selectedCollege ? '/cafes?college=' + encodeURIComponent(selectedCollege) : '/cafes' %>" 
               class="nav-link <%= currentPath.startsWith('/cafes') ? 'active' : '' %>">
                Cafes
            </a>

            <a href="<%= selectedCollege ? '/laundries?college=' + encodeURIComponent(selectedCollege) : '/laundries' %>" 
               class="nav-link <%= currentPath.startsWith('/laundries') ? 'active' : '' %>">
                Laundry
            </a>

            <a href="/about" 
               class="nav-link <%= currentPath.startsWith('/about') ? 'active' : '' %>">
                About
            </a>
        </div>

        <!-- RIGHT SIDE ACTIONS -->
        <div class="navbar-actions">
            <!-- Add New Service -->
            <button type="button" class="add-property-btn" data-bs-toggle="modal" data-bs-target="#categoryModal">
                <i class="fa-solid fa-plus"></i>
                <span>Add New Service</span>
            </button>

            <!-- Authentication -->
            <% if (!currUser) { %>
                <a href="/signup" class="auth-link">Signup</a>
                <a href="/login" class="auth-link login-link">Login</a>
            <% } else { %>
                <span class="welcome-user">Hi, <%= currUser.username %></span>
                <a href="/logout" class="auth-link">Logout</a>
            <% } %>
        </div>

        <!-- MOBILE MENU BUTTON -->
        <button class="mobile-menu-btn" id="mobileMenuBtn" type="button" aria-label="Toggle navigation">
            <i class="fa-solid fa-bars"></i>
        </button>

    </div>

</nav>


<!-- =========================================================
     ADD NEW SERVICE MODAL
========================================================= -->

<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <!-- MODAL HEADER -->
            <div class="modal-header">
                <div>
                    <h4 class="modal-title" id="categoryModalLabel">Add New Service</h4>
                    <p class="text-muted mb-0">What would you like to list?</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- MODAL BODY -->
            <div class="modal-body p-4">
                <form id="categoryForm">
                    <div class="mb-4">
                        <label for="serviceCategory" class="form-label fw-semibold">Select Category</label>
                        <select id="serviceCategory" class="form-select form-select-lg" required>
                            <option value="" selected disabled>Choose a category</option>
                            <option value="pg">PG</option>
                            <option value="cafe">Cafe</option>
                            <option value="mess">Mess</option>
                            <option value="laundry">Laundry</option>
                        </select>
                    </div>

                    <!-- BUTTONS -->
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark px-4">Continue</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>