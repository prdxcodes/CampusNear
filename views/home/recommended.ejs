<section class="recommended-section">

    <!-- =========================
         SECTION HEADER
    ========================== -->

    <div class="section-header">

        <div>

            <span class="section-label">
                CAMPUSNEAR PICKS
            </span>

            <h2>
                Popular PGs on CampusNear
            </h2>

            <p>
                Comfortable places selected for students near your campus.
            </p>

        </div>


        <a href="/pgs" class="view-all-btn">
            View all
            <i class="fa-solid fa-arrow-right"></i>
        </a>

    </div>


    <!-- =========================
         PG CARDS
    ========================== -->

    <div class="row g-4">

        <% if (pgs && pgs.length > 0) { %>

            <% pgs.slice(0, 6).forEach(pg => { %>

                <div class="col-xl-4 col-lg-4 col-md-6">

                    <a
                        href="/pgs/<%= pg._id %>"
                        class="text-decoration-none"
                    >

                        <div class="recommended-card">


                            <!-- =========================
                                 IMAGE
                            ========================== -->

                            <div class="recommended-image-wrapper">

                                <% if (pg.image && pg.image.url) { %>

                                    <img
                                        src="<%= pg.image.url %>"
                                        alt="<%= pg.title %>"
                                        class="recommended-image"
                                    >

                                <% } else { %>

                                    <div class="no-image">

                                        <i class="fa-solid fa-house"></i>

                                    </div>

                                <% } %>


                                <!-- Recommended Badge -->

                                <span class="featured-badge">

                                    <i class="fa-solid fa-star"></i>

                                    Recommended

                                </span>

                            </div>


                            <!-- =========================
                                 CARD BODY
                            ========================== -->

                            <div class="recommended-card-body">


                                <!-- CATEGORY -->

                                <div class="listing-category">
                                    PG
                                </div>


                                <!-- TITLE -->

                                <h3 class="property-title">

                                    <%= pg.title %>

                                </h3>


                                <!-- LOCATION -->

                                <% if (pg.location) { %>

                                    <div class="property-location">

                                        <i class="fa-solid fa-location-dot"></i>

                                        <span>
                                            <%= pg.location %>
                                        </span>

                                    </div>

                                <% } %>


                                <!-- =========================
                                     PG INFORMATION
                                ========================== -->

                                <div class="property-info">

                                    <% if (pg.ownerContact) { %>

                                        <span>

                                            <i class="fa-solid fa-phone"></i>

                                            Contact Available

                                        </span>

                                    <% } %>


                                    <% if (pg.country) { %>

                                        <span>

                                            <i class="fa-solid fa-earth-asia"></i>

                                            <%= pg.country %>

                                        </span>

                                    <% } %>

                                </div>


                                <!-- =========================
                                     BOTTOM
                                ========================== -->

                                <div class="property-footer">


                                    <!-- PRICE -->

                                    <div class="property-price">

                                        <strong>

                                            ₹<%= pg.price
                                                ? pg.price.toLocaleString("en-IN")
                                                : "N/A"
                                            %>

                                        </strong>


                                        <% if (pg.price) { %>

                                            <span>
                                                / month
                                            </span>

                                        <% } %>

                                    </div>


                                    <!-- VIEW PG BUTTON -->

                                    <span class="feature-badge">

                                        View PG

                                    </span>


                                </div>


                            </div>

                        </div>

                    </a>

                </div>

            <% }) %>


        <% } else { %>


            <!-- =========================
                 EMPTY STATE
            ========================== -->

            <div class="col-12">

                <div class="empty-properties">

                    <i class="fa-regular fa-building"></i>

                    <h4>
                        No PGs available yet
                    </h4>

                    <p>
                        New PGs will appear here soon.
                    </p>

                </div>

            </div>


        <% } %>

    </div>

</section>