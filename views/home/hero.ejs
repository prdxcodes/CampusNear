<section class="campusnear-hero">

    <div class="hero-overlay"></div>

    <div class="container hero-content">

        <!-- =========================
             HERO TEXT
        ========================== -->

        <div class="hero-text">

            <h1>
                Everything You Need,
                <br>
                Near Your Campus
            </h1>

            <p>
                PGs, Messes, Cafes & essential places —
                all in one place.
            </p>

        </div>


        <!-- =========================
             SEARCH BOX
        ========================== -->

        <form
            action="/pgs"
            method="GET"
            class="hero-search"
            id="collegeSearchForm"
        >

            <!-- =========================
                 COLLEGE SEARCH
            ========================== -->

            <div class="search-field location-field">

                <i class="fa-solid fa-location-dot"></i>

                <div class="search-field-content">

                    <label for="collegeSearch">
                        College
                    </label>

                    <input
                        type="text"
                        id="collegeSearch"
                        name="college"
                        placeholder="Search your college..."
                        autocomplete="off"
                        required
                    >

                    <!-- Suggestions -->

                    <div
                        id="collegeSuggestions"
                        class="college-suggestions"
                    ></div>

                </div>

            </div>


            <!-- =========================
                 DIVIDER
            ========================== -->

            <div class="search-divider"></div>


            <!-- =========================
                 CATEGORY
            ========================== -->

            <div class="search-field">

                <i class="fa-solid fa-building"></i>

                <div class="search-field-content">

                    <label for="category">
                        Looking for
                    </label>

                    <select
                        id="category"
                        name="category"
                    >

                        <option value="pg" selected>
                            PG
                        </option>

                        <option value="cafe">
                            Cafe
                        </option>

                        <option value="mess">
                            Mess
                        </option>

                        <option value="laundry">
                            Laundry
                        </option>

                    </select>

                </div>

            </div>


            <!-- =========================
                 DIVIDER
            ========================== -->

            <div class="search-divider"></div>


            <!-- =========================
                 SEARCH BUTTON
            ========================== -->

            <button
                type="submit"
                class="hero-search-btn"
            >

                <i class="fa-solid fa-magnifying-glass"></i>

                <span>
                    Search
                </span>

            </button>

        </form>


        <!-- =========================
             QUICK SEARCH
        ========================== -->

        <div class="hero-quick-search">

            <span>
                Popular:
            </span>

            <a href="/pgs?college=AKGEC">
                AKGEC
            </a>

            <a href="/pgs?college=Galgotias University">
                Galgotias University
            </a>

            <a href="/pgs?college=ABES">
                ABES
            </a>

            <a href="/pgs?college=Jaypee Institute of Information Technology">
                Jaypee Institute of Information Technology
            </a>

        </div>

    </div>

</section>


<!-- =========================================================
     COLLEGE AUTOCOMPLETE
========================================================= -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const collegeInput =
        document.getElementById("collegeSearch");

    const suggestionsBox =
        document.getElementById("collegeSuggestions");

    const searchForm =
        document.getElementById("collegeSearchForm");


    if (!collegeInput || !suggestionsBox) {
        return;
    }


    let colleges = [];


    // =====================================================
    // GET COLLEGES FROM SERVER
    // =====================================================

    fetch("/colleges/search")
        .then(response => response.json())
        .then(data => {

            colleges = data;

        })
        .catch(error => {

            console.error(
                "College search error:",
                error
            );

        });


    // =====================================================
    // INPUT EVENT
    // =====================================================

    collegeInput.addEventListener("input", function () {

        const searchValue =
            collegeInput.value
                .trim()
                .toLowerCase();


        suggestionsBox.innerHTML = "";


        if (!searchValue) {

            suggestionsBox.style.display = "none";

            return;

        }


        const filteredColleges =
            colleges.filter(college => {

                const name =
                    college.name
                        .toLowerCase();

                const shortName =
                    college.shortName
                        ? college.shortName.toLowerCase()
                        : "";

                return (
                    name.includes(searchValue) ||
                    shortName.includes(searchValue)
                );

            }).slice(0, 8);


        if (filteredColleges.length === 0) {

            suggestionsBox.style.display = "none";

            return;

        }


        // =================================================
        // CREATE SUGGESTIONS
        // =================================================

        filteredColleges.forEach(college => {

            const suggestion =
                document.createElement("div");

            suggestion.classList.add(
                "college-suggestion-item"
            );


            suggestion.innerHTML = `

                <i class="fa-solid fa-building-columns"></i>

                <div>

                    <strong>
                        ${college.name}
                    </strong>

                    ${
                        college.shortName
                        ? `<small>${college.shortName}</small>`
                        : ""
                    }

                    <span>
                        ${college.city}, ${college.state}
                    </span>

                </div>

            `;


            suggestion.addEventListener(
                "click",
                function () {

                    collegeInput.value =
                        college.name;

                    suggestionsBox.innerHTML = "";

                    suggestionsBox.style.display =
                        "none";

                }
            );


            suggestionsBox.appendChild(
                suggestion
            );

        });


        suggestionsBox.style.display = "block";

    });


    // =====================================================
    // CLICK OUTSIDE
    // =====================================================

    document.addEventListener(
        "click",
        function (event) {

            if (
                !collegeInput.contains(event.target) &&
                !suggestionsBox.contains(event.target)
            ) {

                suggestionsBox.style.display =
                    "none";

            }

        }
    );


    // =====================================================
    // FORM VALIDATION
    // =====================================================

    searchForm.addEventListener(
        "submit",
        function (event) {

            if (!collegeInput.value.trim()) {

                event.preventDefault();

                collegeInput.focus();

            }

        }
    );

});

</script>