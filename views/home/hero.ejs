<section class="campusnear-hero">

    <div class="hero-overlay"></div>

    <div class="container hero-content">

        <!-- =========================
             HERO TEXT
        ========================== -->

        <div class="hero-text">

            <h1>
                Everything You Need,
                <br>
                Near Your Campus
            </h1>

            <p>
                PGs, Messes, Cafes & essential places —
                all in one place.
            </p>

        </div>


        <!-- =========================
             SEARCH BOX
        ========================== -->

        <form
            method="GET"
            class="hero-search"
            id="collegeSearchForm"
        >

            <!-- =========================
                 COLLEGE SEARCH
            ========================== -->

            <div class="search-field location-field">

                <i class="fa-solid fa-location-dot"></i>

                <div class="search-field-content">

                    <label for="collegeSearch">
                        College
                    </label>

                    <input
                        type="text"
                        id="collegeSearch"
                        name="college"
                        placeholder="Search your college..."
                        autocomplete="off"
                        required
                    >

                    <div
                        id="collegeSuggestions"
                        class="college-suggestions"
                    ></div>

                </div>

            </div>


            <!-- =========================
                 DIVIDER
            ========================== -->

            <div class="search-divider"></div>


            <!-- =========================
                 CATEGORY DROPDOWN
            ========================== -->

            <div class="search-field custom-dropdown-container">

                <i class="fa-solid fa-building"></i>

                <div
                    class="search-field-content custom-select-wrapper"
                    id="heroCategoryDropdown"
                >

                    <label>
                        Looking for
                    </label>


                    <!-- =========================
                         SELECTED CATEGORY
                    ========================== -->

                    <div class="custom-select-trigger">

                        <span id="heroSelectedCategoryText">
                            PG
                        </span>

                        <i class="fa-solid fa-chevron-down"></i>

                    </div>


                    <!-- =========================
                         HIDDEN CATEGORY VALUE
                    ========================== -->

                    <input
                        type="hidden"
                        name="category"
                        id="heroCategoryValue"
                        value="pg"
                    >


                    <!-- =========================
                         CATEGORY OPTIONS
                    ========================== -->

                    <ul class="custom-options-list">

                        <li
                            class="custom-option active"
                            data-value="pg"
                        >
                            PG
                        </li>

                        <li
                            class="custom-option"
                            data-value="cafe"
                        >
                            Cafe
                        </li>

                        <li
                            class="custom-option"
                            data-value="mess"
                        >
                            Mess
                        </li>

                        <li
                            class="custom-option"
                            data-value="laundry"
                        >
                            Laundry
                        </li>

                    </ul>

                </div>

            </div>


            <!-- =========================
                 DIVIDER
            ========================== -->

            <div class="search-divider"></div>


            <!-- =========================
                 SEARCH BUTTON
            ========================== -->

            <button
                type="submit"
                class="hero-search-btn"
            >

                <i class="fa-solid fa-magnifying-glass"></i>

                <span>
                    Search
                </span>

            </button>

        </form>


        <!-- =========================
             QUICK SEARCH
        ========================== -->

        <div class="hero-quick-search">

            <span>
                Popular:
            </span>

            <a href="/pgs?college=AKGEC">
                AKGEC
            </a>

            <a href="/pgs?college=Galgotias University">
                Galgotias University
            </a>

            <a href="/pgs?college=ABES">
                ABES
            </a>

            <a href="/pgs?college=Jaypee Institute of Information Technology">
                Jaypee Institute of Information Technology
            </a>

        </div>

    </div>

</section>