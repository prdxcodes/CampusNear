<section class="campusnear-hero">

    <div class="hero-overlay"></div>

    <div class="container hero-content">

        <!-- =========================
             HERO TEXT
        ========================== -->

        <div class="hero-text">

            <h1>
                Everything You Need,
                <br>
                Near Your Campus
            </h1>

            <p>
                PGs, Messes, Cafes & essential places —
                all in one place.
            </p>

        </div>


        <!-- =========================
             SEARCH BOX
        ========================== -->

        <form
            method="GET"
            class="hero-search"
            id="collegeSearchForm"
        >

            <!-- =========================
                 COLLEGE SEARCH
            ========================== -->

            <div class="search-field location-field">

                <i class="fa-solid fa-location-dot"></i>

                <div class="search-field-content">

                    <label for="collegeSearch">
                        College
                    </label>

                    <input
                        type="text"
                        id="collegeSearch"
                        name="college"
                        placeholder="Search your college..."
                        autocomplete="off"
                        required
                    >

                    <div
                        id="collegeSuggestions"
                        class="college-suggestions"
                    ></div>

                </div>

            </div>


            <!-- =========================
                 DIVIDER
            ========================== -->

            <div class="search-divider"></div>


            <!-- =========================
                 CATEGORY
            ========================== -->

            <div class="search-field">

                <i class="fa-solid fa-building"></i>

                <div class="search-field-content">

                    <label for="category">
                        Looking for
                    </label>

                    <select
                        id="category"
                        name="category"
                    >

                        <option value="pg" selected>
                            PG
                        </option>

                        <option value="cafe">
                            Cafe
                        </option>

                        <option value="mess">
                            Mess
                        </option>

                        <option value="laundry">
                            Laundry
                        </option>

                    </select>

                </div>

            </div>


            <!-- =========================
                 DIVIDER
            ========================== -->

            <div class="search-divider"></div>


            <!-- =========================
                 SEARCH BUTTON
            ========================== -->

            <button
                type="submit"
                class="hero-search-btn"
            >

                <i class="fa-solid fa-magnifying-glass"></i>

                <span>
                    Search
                </span>

            </button>

        </form>


        <!-- =========================
             QUICK SEARCH
        ========================== -->

        <div class="hero-quick-search">

            <span>
                Popular:
            </span>

            <a href="/pgs?college=AKGEC">
                AKGEC
            </a>

            <a href="/pgs?college=Galgotias University">
                Galgotias University
            </a>

            <a href="/pgs?college=ABES">
                ABES
            </a>

            <a href="/pgs?college=Jaypee Institute of Information Technology">
                Jaypee Institute of Information Technology
            </a>

        </div>

    </div>

</section>