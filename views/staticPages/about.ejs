                </div>
            </a>


            <a href="/laundries" class="category-card">
                <div class="category-image laundry-image">
                    <i class="fa-solid fa-shirt"></i>
                </div>

                <div class="category-info">
                    <h3>Laundry</h3>
                    <p>Find convenient laundry services.</p>
                    <span>
                        Explore
                        <i class="fa-solid fa-arrow-right"></i>
                    </span>
                </div>
            </a>


            <a href="#" class="category-card">
                <div class="category-image stationery-image">
                    <i class="fa-solid fa-book"></i>
                </div>

                <div class="category-info">
                    <h3>Stationery</h3>
                    <p>Find stationery and academic essentials.</p>
                    <span>
                        Coming Soon
                        <i class="fa-solid fa-arrow-right"></i>
                    </span>
                </div>
            </a>

        </div>

    </section>


