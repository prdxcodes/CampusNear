<% layout("/layouts/boilerplate") %>

<div class="about-page">

    <!-- =========================
         HERO SECTION
    ========================== -->
    <section class="about-hero">
        <div class="about-hero-content">

            <span class="about-badge">ABOUT CAMPUSNEAR</span>

            <h1>
                Find Everything You Need
                <span>Around Your Campus.</span>
            </h1>

            <p>
                CampusNear helps students discover PGs, hostels, cafes,
                messes, laundry services and other essential places
                near their college — all in one place.
            </p>

            <div class="about-hero-buttons">
                <a href="/" class="about-btn primary-btn">
                    Explore Places
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

                <a href="#how-it-works" class="about-btn secondary-btn">
                    How It Works
                </a>
            </div>

        </div>

        <div class="about-hero-visual">

            <div class="floating-card card-top">
                <i class="fa-solid fa-location-dot"></i>
                <div>
                    <strong>Nearby Places</strong>
                    <span>Around your campus</span>
                </div>
            </div>

            <div class="campus-illustration">

                <div class="illustration-circle"></div>

                <div class="illustration-icon icon-home">
                    <i class="fa-solid fa-house"></i>
                </div>

                <div class="illustration-icon icon-food">
                    <i class="fa-solid fa-utensils"></i>
                </div>

                <div class="illustration-icon icon-coffee">
                    <i class="fa-solid fa-mug-hot"></i>
                </div>

                <div class="illustration-icon icon-laundry">
                    <i class="fa-solid fa-shirt"></i>
                </div>

                <div class="campus-pin">
                    <i class="fa-solid fa-location-dot"></i>
                </div>

            </div>

            <div class="floating-card card-bottom">
                <i class="fa-solid fa-compass"></i>
                <div>
                    <strong>Explore Easily</strong>
                    <span>Search • Discover • Connect</span>
                </div>
            </div>

        </div>
    </section>


    <!-- =========================
         WHAT IS CAMPUSNEAR
    ========================== -->
    <section class="about-section intro-section">

        <div class="section-heading">
            <span class="section-label">WHO WE ARE</span>

            <h2>
                What is <span>CampusNear?</span>
            </h2>

            <p>
                A simple way for students to discover the places
                they need around their campus.
            </p>
        </div>

        <div class="intro-content">

            <div class="intro-text">

                <p>
                    Finding a suitable place to stay or essential services
                    near a college can be surprisingly difficult. Students
                    often depend on friends, seniors, scattered listings,
                    or multiple platforms to find what they need.
                </p>

                <p>
                    <strong>CampusNear brings these options together.</strong>
                    Students can explore nearby PGs, hostels, cafes,
                    messes, laundry services and more from one platform.
                </p>

                <p>
                    Our goal is simple — make campus life easier by
                    helping students discover useful places around
                    their college quickly and conveniently.
                </p>

            </div>

            <div class="intro-highlight">

                <div class="highlight-icon">
                    <i class="fa-solid fa-map-location-dot"></i>
                </div>

                <h3>
                    Everything Nearby,
                    <span>One Platform.</span>
                </h3>

                <p>
                    Discover places based on your campus and
                    make better decisions with useful information
                    at your fingertips.
                </p>

            </div>

        </div>

    </section>


    <!-- =========================
         WHY CAMPUSNEAR
    ========================== -->
    <section class="about-section why-section">

        <div class="section-heading center-heading">

            <span class="section-label">WHY CAMPUSNEAR</span>

            <h2>
                Built Around <span>Student Needs.</span>
            </h2>

            <p>
                We focus on making everyday campus discovery
                faster and easier.
            </p>

        </div>

        <div class="feature-grid">

            <div class="feature-card">

                <div class="feature-icon">
                    <i class="fa-solid fa-house"></i>
                </div>

                <h3>Find a Stay</h3>

                <p>
                    Discover PGs and hostels near your college
                    without searching across multiple platforms.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    <i class="fa-solid fa-location-dot"></i>
                </div>

                <h3>Location-Based</h3>

                <p>
                    Find places around your campus and understand
                    where they are located using map-based information.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    <i class="fa-solid fa-utensils"></i>
                </div>

                <h3>Student Essentials</h3>

                <p>
                    Explore cafes, messes, laundry services,
                    stationery and other useful places.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    <i class="fa-solid fa-bolt"></i>
                </div>

                <h3>Save Time</h3>

                <p>
                    Get useful information in one place and
                    spend less time searching for nearby services.
                </p>

            </div>

        </div>

    </section>


    <!-- =========================
         HOW IT WORKS
    ========================== -->
    <section class="about-section how-section" id="how-it-works">

        <div class="section-heading center-heading">

            <span class="section-label">HOW IT WORKS</span>

            <h2>
                Three Steps. <span>That's It.</span>
            </h2>

            <p>
                Finding what you need around your campus
                doesn't have to be complicated.
            </p>

        </div>


        <div class="steps-container">

            <div class="step-card">

                <div class="step-number">01</div>

                <div class="step-icon">
                    <i class="fa-solid fa-building-columns"></i>
                </div>

                <h3>Select Your College</h3>

                <p>
                    Search for your college and choose your
                    campus to start exploring nearby places.
                </p>

            </div>


            <div class="step-line"></div>


            <div class="step-card">

                <div class="step-number">02</div>

                <div class="step-icon">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>

                <h3>Explore Nearby Places</h3>

                <p>
                    Browse PGs, hostels, cafes, messes,
                    laundry and other useful services.
                </p>

            </div>


            <div class="step-line"></div>


            <div class="step-card">

                <div class="step-number">03</div>

                <div class="step-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>

                <h3>Choose What Fits You</h3>

                <p>
                    Check details, prices, contact information
                    and locations before making your choice.
                </p>

            </div>

        </div>

    </section>


