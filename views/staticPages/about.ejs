                    </span>
                </div>
            </a>


            <a href="/messes" class="category-card">
                <div class="category-image mess-image">
                    <i class="fa-solid fa-utensils"></i>
                </div>

                <div class="category-info">
                    <h3>Mess</h3>
                    <p>Discover nearby food and mess services.</p>
                    <span>
