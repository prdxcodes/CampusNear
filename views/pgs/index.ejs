<% layout("/layouts/boilerplate") %>

<div class="listing-page">

    <div class="listing-header">

        <div>

            <p class="section-label">
                STUDENT ACCOMMODATION
            </p>

            <h1>
                <%= selectedCollege
                    ? `PGs Near ${selectedCollege.name}`
                    : "Find PGs Near Your College"
                %>
            </h1>

            <p class="listing-subtitle">

                <% if (selectedCollege) { %>

                    Showing PGs within 5 km of
                    <strong>
                        <%= selectedCollege.name %>
                    </strong>.

                <% } else { %>

                    Select your college to discover PGs within 5 km
                    of your campus.

                <% } %>

            </p>

        </div>

        <div class="listing-count">
            <%= allPlaces.length %> PGs
        </div>

    </div>


    <div class="row">

        <% if (!selectedCollege) { %>

            <div class="col-12">

                <div class="empty-state">

                    <i class="fa-solid fa-location-dot"></i>

                    <h3>
                        Select Your College
                    </h3>

                    <p>
                        Choose your college from the search bar on the
                        homepage to find PGs within 5 km of your campus.
                    </p>

                    <a href="/" class="btn btn-dark">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        Search College
                    </a>

                </div>

            </div>


        <% } else if (allPlaces.length === 0) { %>

            <div class="col-12">

                <div class="empty-state">

                    <i class="fa-solid fa-house"></i>

                    <h3>
                        No PGs Found Nearby
                    </h3>

                    <p>
                        There are currently no PGs listed within 5 km of
                        <strong><%= selectedCollege.name %></strong>.
                    </p>

                    <a href="/pgs/new" class="btn btn-dark">
                        <i class="fa-solid fa-plus"></i>
                        Add PG
                    </a>

                </div>

            </div>


        <% } else { %>

            <% allPlaces.forEach(pg => { %>

                <div class="col-lg-4 col-md-6 mb-4">

                    <a
                        href="/pgs/<%= pg._id %>"
                        class="text-decoration-none"
                    >

                        <div class="listing-card">

                            <!-- ================= IMAGE ================= -->

                            <div class="listing-image-wrapper">

                                <% if (pg.image && pg.image.url) { %>

                                    <img
                                        src="<%= pg.image.url %>"
                                        alt="<%= pg.title %>"
                                        class="listing-image"
                                    >

                                <% } else { %>

                                    <div class="no-image">
                                        <i class="fa-solid fa-house"></i>
                                    </div>

                                <% } %>

                            </div>


                            <!-- ================= CARD BODY ================= -->

                            <div class="listing-card-body">

                                <!-- CATEGORY -->

                                <div class="listing-category">
                                    PG
                                </div>


                                <!-- TITLE -->

                                <h3>
                                    <%= pg.title %>
                                </h3>


                                <!-- LOCATION -->

                                <% if (pg.location) { %>

                                    <p class="listing-location">

                                        <i class="fa-solid fa-location-dot"></i>

                                        <%= pg.location %>

                                    </p>

                                <% } %>


                                <!-- ================= PG INFORMATION ================= -->

                                <div class="listing-info">

                                    <% if (pg.ownerContact) { %>

                                        <span>
                                            <i class="fa-solid fa-phone"></i>

                                            Contact Available
                                        </span>

                                    <% } %>


                                    <% if (pg.country) { %>

                                        <span>
                                            <i class="fa-solid fa-earth-asia"></i>

                                            <%= pg.country %>
                                        </span>

                                    <% } %>

                                </div>


                                <!-- ================= BOTTOM ================= -->

                                <div class="listing-bottom">

                                    <strong>

                                        ₹<%= pg.price || "N/A" %>

                                        <% if (pg.price) { %>

                                            <small>
                                                / month
                                            </small>

                                        <% } %>

                                    </strong>


                                    <span class="feature-badge">

                                        View PG

                                    </span>

                                </div>

                            </div>

                        </div>

                    </a>

                </div>

            <% }) %>

        <% } %>

    </div>

</div>