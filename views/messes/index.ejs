<% layout("/layouts/boilerplate") %>

<div class="listing-page">

    <div class="listing-header">

        <div>

            <p class="section-label">
                FOOD SERVICES
            </p>

            <h1>
                <%= selectedCollege
                    ? `Mess Near ${selectedCollege.name}`
                    : "Find Messes Near Your College"
                %>
            </h1>

            <p class="listing-subtitle">

                <% if (selectedCollege) { %>

                    Showing messes within 5 km of
                    <strong>
                        <%= selectedCollege.name %>
                    </strong>.

                <% } else { %>

                    Select your college to discover messes within 5 km
                    of your campus.

                <% } %>

            </p>

        </div>

        <div class="listing-count">
            <%= allPlaces.length %> Messes
        </div>

    </div>


    <div class="row">

        <% if (!selectedCollege) { %>

            <div class="col-12">

                <div class="empty-state">

                    <i class="fa-solid fa-location-dot"></i>

                    <h3>
                        Select Your College
                    </h3>

                    <p>
                        Choose your college from the homepage to find
                        nearby messes.
                    </p>

                    <a href="/" class="btn btn-dark">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        Search College
                    </a>

                </div>

            </div>

        <% } else if (allPlaces.length === 0) { %>

            <div class="col-12">

                <div class="empty-state">

                    <i class="fa-solid fa-bowl-food"></i>

                    <h3>
                        No Messes Found Nearby
                    </h3>

                    <p>
                        There are currently no messes listed within 5 km of
                        <strong><%= selectedCollege.name %></strong>.
                    </p>

                    <a href="/messes/new" class="btn btn-dark">
                        Add Mess
                    </a>

                </div>

            </div>

        <% } else { %>

            <% allPlaces.forEach(mess => { %>

                <div class="col-lg-4 col-md-6 mb-4">

                    <a
                        href="/messes/<%= mess._id %>"
                        class="text-decoration-none"
                    >

                        <div class="listing-card">

                            <div class="listing-image-wrapper">

                                <% if (mess.image && mess.image.url) { %>

                                    <img
                                        src="<%= mess.image.url %>"
                                        alt="<%= mess.title %>"
                                        class="listing-image"
                                    >

                                <% } else { %>

                                    <div class="no-image">
                                        <i class="fa-solid fa-bowl-food"></i>
                                    </div>

                                <% } %>

                            </div>


                            <div class="listing-card-body">

                                <div class="listing-category">
                                    MESS
                                </div>

                                <h3>
                                    <%= mess.title %>
                                </h3>

                                <p class="listing-location">

                                    <i class="fa-solid fa-location-dot"></i>

                                    <%= mess.location %>

                                </p>

                                <div class="listing-info">

                                    <span>
                                        <i class="fa-solid fa-utensils"></i>
                                        <%= mess.mealType %>
                                    </span>

                                    <span>
                                        <i class="fa-regular fa-clock"></i>
                                        <%= mess.openingTime %>
                                        -
                                        <%= mess.closingTime %>
                                    </span>

                                </div>


                                <% if (mess.meals && mess.meals.length) { %>

                                    <div class="meal-features">

                                        <% if (mess.meals.includes("Breakfast")) { %>

                                            <span>
                                                Breakfast
                                            </span>

                                        <% } %>

                                        <% if (mess.meals.includes("Lunch")) { %>

                                            <span>
                                                Lunch
                                            </span>

                                        <% } %>

                                        <% if (mess.meals.includes("Dinner")) { %>

                                            <span>
                                                Dinner
                                            </span>

                                        <% } %>

                                    </div>

                                <% } %>


                                <div class="listing-bottom">

                                    <strong>
                                        ₹<%= mess.price %>
                                        <small>/ month</small>
                                    </strong>

                                    <span class="feature-badge">
                                        View Mess
                                    </span>

                                </div>

                            </div>

                        </div>

                    </a>

                </div>

            <% }) %>

        <% } %>

    </div>

</div>