<% layout("/layouts/boilerplate") %>

<div class="listing-page">

    <div class="listing-header">

        <div>

            <p class="section-label">
                FOOD & BEVERAGES
            </p>

            <h1>
                <%= selectedCollege
                    ? `Cafes Near ${selectedCollege.name}`
                    : "Find Cafes Near Your College"
                %>
            </h1>

            <p class="listing-subtitle">

                <% if (selectedCollege) { %>

                    Showing cafes within 5 km of
                    <strong>
                        <%= selectedCollege.name %>
                    </strong>.

                <% } else { %>

                    Select your college to discover cafes within 5 km
                    of your campus.

                <% } %>

            </p>

        </div>

        <div class="listing-count">
            <%= allPlaces.length %> Cafes
        </div>

    </div>


    <div class="row">

        <% if (!selectedCollege) { %>

            <div class="col-12">

                <div class="empty-state">

                    <i class="fa-solid fa-location-dot"></i>

                    <h3>
                        Select Your College
                    </h3>

                    <p>
                        Choose your college from the homepage to find
                        nearby cafes.
                    </p>

                    <a href="/" class="btn btn-dark">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        Search College
                    </a>

                </div>

            </div>

        <% } else if (allPlaces.length === 0) { %>

            <div class="col-12">

                <div class="empty-state">

                    <i class="fa-solid fa-mug-hot"></i>

                    <h3>
                        No Cafes Found Nearby
                    </h3>

                    <p>
                        There are currently no cafes listed within 5 km of
                        <strong><%= selectedCollege.name %></strong>.
                    </p>

                    <a href="/cafes/new" class="btn btn-dark">
                        Add Cafe
                    </a>

                </div>

            </div>

        <% } else { %>

            <% allPlaces.forEach(cafe => { %>

                <div class="col-lg-4 col-md-6 mb-4">

                    <a
                        href="/cafes/<%= cafe._id %>"
                        class="text-decoration-none"
                    >

                        <div class="listing-card">

                            <div class="listing-image-wrapper">

                                <% if (cafe.image && cafe.image.url) { %>

                                    <img
                                        src="<%= cafe.image.url %>"
                                        alt="<%= cafe.title %>"
                                        class="listing-image"
                                    >

                                <% } else { %>

                                    <div class="no-image">
                                        <i class="fa-solid fa-mug-hot"></i>
                                    </div>

                                <% } %>

                            </div>


                            <div class="listing-card-body">

                                <div class="listing-category">
                                    CAFE
                                </div>

                                <h3>
                                    <%= cafe.title %>
                                </h3>

                                <p class="listing-location">

                                    <i class="fa-solid fa-location-dot"></i>

                                    <%= cafe.location %>

                                </p>

                                <div class="listing-info">

                                    <span>
                                        <i class="fa-solid fa-utensils"></i>
                                        <%= cafe.cuisine %>
                                    </span>

                                    <span>
                                        <i class="fa-regular fa-clock"></i>
                                        <%= cafe.openingTime %>
                                        -
                                        <%= cafe.closingTime %>
                                    </span>

                                </div>

                                <div class="listing-bottom">

                                    <strong>
                                        ₹<%= cafe.price %>
                                    </strong>

                                    <span class="feature-badge">
                                        View Cafe
                                    </span>

                                </div>

                            </div>

                        </div>

                    </a>

                </div>

            <% }) %>

        <% } %>

    </div>

</div>